#!/usr/bin/env python3
"""Run each dataset fetcher, retaining a nonzero exit status if any fail."""

import argparse
import subprocess
import sys
from pathlib import Path


def main():
    """Fetch every dataset, continuing past errors so other downloads can finish."""
    root = Path(__file__).resolve().parent
    scripts = {script.parent.name: script for script in sorted(root.glob("*/fetch"))}
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "datasets", nargs="*", help="dataset directory names (default: all)"
    )
    args = parser.parse_args()
    unknown = sorted(set(args.datasets) - scripts.keys())
    if unknown:
        parser.error("Unknown datasets: " + ", ".join(unknown))
    failed = []
    for name in dict.fromkeys(args.datasets or scripts):
        script = scripts[name]
        print(f"\n=== {script.parent.name} ===", flush=True)
        result = subprocess.run([str(script)], cwd=script.parent, check=False)
        if result.returncode:
            failed.append(script.parent.name)
    if failed:
        print("Failed datasets: " + ", ".join(failed), file=sys.stderr)
    return bool(failed)


if __name__ == "__main__":
    sys.exit(main())
