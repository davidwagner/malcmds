#!/usr/bin/env python3
"""Fetch only OpTC endpoint data and its published red-team ground truth."""

import os
import subprocess
import sys
import venv
from pathlib import Path

os.chdir(Path(__file__).resolve().parent)
sys.path.insert(0, str(Path.cwd().parent))
from _fetch import github

FOLDER = "1NwaCWRyr_coyPbF2SvScbani5O9MXp7_"


def selected(name):
    """Include schema, known data errors, and the red team's attack narrative."""
    return name in {"OpTCRedTeamGroundTruth.pdf", "ecar.md", "errata.md", "README.md"}


github("FiveDirections/OpTC-data", selected, ref="5b108604f11f767aa11ea79ff827595f3fad15fd")
if os.environ.get("FETCH_LIST") == "1":
    print(
        f"ecar/ (recursive: benign, evaluation, short)\t?\thttps://drive.google.com/drive/folders/{FOLDER}"
    )
else:
    # Isolated, pinned dependency; never prompt or modify system Python.
    python = Path(".fetch-venv/bin/python").resolve()
    if not python.exists():
        venv.create(python.parent.parent, with_pip=True)
    ready = python.parent.parent / "gdown-6.4.1.ready"
    if not ready.exists():
        subprocess.run(
            [
                str(python),
                "-m",
                "pip",
                "--disable-pip-version-check",
                "install",
                "--no-input",
                "gdown==6.4.1",
            ],
            check=True,
        )
        ready.touch()
    # 6.4.1 uses Drive's embedded folder listing, without the old 50-item cutoff.
    # resume=True skips completed files and resumes gdown's partial files.
    subprocess.run(
        [
            str(python),
            "-c",
            "import gdown; files = gdown.download_folder("
            f"id={FOLDER!r}, output='ecar', resume=True, "
            "use_cookies=False, timeout=60, retries=4); "
            "assert files, 'Drive returned no files'",
        ],
        check=True,
    )
