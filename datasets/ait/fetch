#!/usr/bin/env python3
"""Download the published command data without extracting it."""

import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent.parent / "scripts"))
from _fetch import zenodo

os.chdir(HERE)


def selected(name):
    """Select the published files containing command records and labels."""
    return name.endswith("_no-pcaps.zip")


zenodo(19483937, selected)
