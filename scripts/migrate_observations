#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["duckdb==1.5.6", "pyarrow==25.0.1", "tree-sitter==0.26.0", "tree-sitter-bash==0.25.1"]
# ///
"""Migrate COMMANDS, then reingest the seven datasets that contain shell input.

Run from any directory with --db /path/to/cmds.duckdb. The schema conversion is
transactional. If reingestion fails, rerun this command: completed datasets are
skipped and incomplete datasets start over. --schema-only defers reingestion.
"""

import argparse
import subprocess
import sys
from pathlib import Path

import duckdb
from _ingest import COLUMNS, SHELL_COLUMNS, _initialize

ROOT = Path(__file__).resolve().parents[1]
DATASETS = ('cyberlab', 'kypo', 'lade', 'microsoft-iot', 'quasarnix', 'shell-honeypot', 'splunk-bots')
LEGACY_COLUMNS = ('pgm', 'pgm_base', 'args', 'shell_input', 'other_tokens', 'dataset',
                  'record_id', 'label', 'group_id', 'session_id', 'os')


def columns(con, table):
    """Return stored columns in their physical order."""
    return tuple(row[0] for row in con.execute(
        'SELECT column_name FROM information_schema.columns '
        'WHERE table_name=? ORDER BY ordinal_position', [table]).fetchall())


def migrate_schema(database):
    """Convert a legacy database atomically, or validate a previous conversion."""
    if not database.is_file():
        raise ValueError(f'Database does not exist: {database}')
    with duckdb.connect(str(database)) as con:
        legacy = columns(con, 'COMMANDS')
        if not legacy:
            if (columns(con, 'PROCESS_LAUNCHES') != COLUMNS
                    or columns(con, 'SHELL_INPUTS') != SHELL_COLUMNS):
                raise ValueError('Database has neither the legacy schema nor the migrated schema')
            return
        if legacy != LEGACY_COLUMNS:
            raise ValueError('COMMANDS does not match the expected legacy schema')
        if columns(con, 'PROCESS_LAUNCHES') or columns(con, 'SHELL_INPUTS'):
            raise ValueError('Database contains both legacy and new observation tables')
        con.execute('BEGIN')
        try:
            placeholders = ','.join('?' for _ in DATASETS)
            unexpected = con.execute(
                f'SELECT dataset FROM COMMANDS WHERE dataset NOT IN ({placeholders}) '
                'AND (shell_input IS NOT NULL OR coalesce(len(other_tokens), 0) != 0) LIMIT 1',
                DATASETS).fetchone()
            if unexpected:
                raise ValueError('Shell data exists outside the seven datasets: ' + unexpected[0])
            con.execute('ALTER TABLE COMMANDS RENAME TO PROCESS_LAUNCHES')
            con.execute('ALTER TABLE PROCESS_LAUNCHES DROP COLUMN shell_input')
            con.execute('ALTER TABLE PROCESS_LAUNCHES DROP COLUMN other_tokens')
            con.execute('ALTER TABLE PROCESS_LAUNCHES RENAME COLUMN label TO dataset_label')
            # DuckDB cannot commit a DELETE followed by ALTER on that table.
            # Alter first, then remove the datasets inside the same transaction.
            con.execute(f'DELETE FROM PROCESS_LAUNCHES WHERE dataset IN ({placeholders})', DATASETS)
            _initialize(con)
            con.execute('CREATE TABLE IF NOT EXISTS INGESTED (dataset VARCHAR, ingested BOOLEAN)')
            con.execute(f'DELETE FROM INGESTED WHERE dataset IN ({placeholders})', DATASETS)
            con.executemany('INSERT INTO INGESTED VALUES (?, false)', [(name,) for name in DATASETS])
        except Exception:
            con.execute('ROLLBACK')
            raise
        con.execute('COMMIT')


def main():
    """Convert the schema and rerun real dataset entry points against this database."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--db', type=Path, default=ROOT / 'cmds.duckdb')
    parser.add_argument('--schema-only', action='store_true', help='defer reingestion until a later run')
    options = parser.parse_args()
    database = options.db.resolve()
    migrate_schema(database)
    if options.schema_only:
        print('Schema ready; rerun without --schema-only to finish any pending reingestion.')
        return 0
    return subprocess.run(
        [sys.executable, str(ROOT / 'scripts/ingestall'), *DATASETS, '--db', str(database)],
        check=False).returncode


if __name__ == '__main__':
    sys.exit(main())
