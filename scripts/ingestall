#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Run every dataset ingester serially, with OpTC last."""

import argparse
import subprocess
import sys
from pathlib import Path

# Static smallest-first estimate from downloaded release sizes on 2026-10-09.
# Used as a runtime heuristic; no disk usage measurements are made when running.
DATASET_ORDER = (
    "kypo",
    "microsoft-iot",
    "lade",
    "shell-honeypot",
    "quasarnix",
    "linux-apt-2024",
    "windows-apt-2025",
    "acme4",
    "splunk-bots",
    "otrf-security-datasets",
    "publicarena",
    "carbanakv2",
    "tc-e3-cadets",
    "acme3",
    "tc-e3-theia",
    "ait",
    "tc-e5-marple",
    "tc-e3-fivedirections",
    "cyberlab",
    "splunkad",
    "atlasv2",
    "tc-e3-trace",
    "tc-e5-theia",
    "tc-e5-cadets",
    "comiset",
    "tc-e5-fivedirections",
    "aviator",
    "autolabel",
    "tc-e5-trace",
    "optc",
)


def main():
    """Forward sample/database options and report every unsuccessful dataset."""
    root = Path(__file__).resolve().parents[1] / "datasets"
    scripts = {p.parent.name: p for p in sorted(root.glob("*/ingest"))}
    default_names = [name for name in DATASET_ORDER if name in scripts]
    default_names.extend(name for name in scripts if name not in DATASET_ORDER)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("datasets", nargs="*", choices=None)
    parser.add_argument("--db")
    parser.add_argument("--limit", type=int)
    parser.add_argument("--max-records", type=int)
    parser.add_argument("--sample-files", type=int)
    parser.add_argument("--seed", type=int)
    parser.add_argument("--batch-size", type=int)
    parser.add_argument("--memory-limit")
    parser.add_argument("--workers", type=int)
    options = parser.parse_args()
    names = list(dict.fromkeys(options.datasets or default_names))
    unknown = sorted(set(names) - scripts.keys())
    if unknown:
        parser.error("Unknown datasets: " + ", ".join(unknown))
    names = [n for n in names if n != "optc"] + (["optc"] if "optc" in names else [])
    forwarded = []
    for key in ("db", "limit", "max_records", "sample_files", "seed", "batch_size", "memory_limit", "workers"):
        value = getattr(options, key)
        if value is not None:
            forwarded.extend(["--" + key.replace("_", "-"), str(value)])
    failed = []
    for name in names:
        print(f"Ingesting {name}", flush=True)
        result = subprocess.run([str(scripts[name]), *forwarded], check=False)
        if result.returncode:
            failed.append(name)
    if failed:
        print("Failed datasets: " + ", ".join(failed), file=sys.stderr)
    return bool(failed)


if __name__ == "__main__":
    sys.exit(main())
