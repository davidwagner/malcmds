#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["duckdb==1.5.6"]
# ///
"""Recompute final labels in SHELL_INPUTS and PROCESS_LAUNCHES.

Example: ./scripts/compute_final_labels --db cmds.duckdb
A human override wins, including unknown. Otherwise, use a known AI label,
then the dataset label. A missing or malicious-group dataset label falls back
to unknown. Existing final labels are overwritten without warnings.
Both tables are updated in one transaction; other columns are preserved.
"""

import argparse
from pathlib import Path

import duckdb

ROOT = Path(__file__).resolve().parents[1]


def compute_final_labels(database):
    """Replace both observation tables' final labels atomically."""
    if not database.is_file():
        raise FileNotFoundError(f'Database does not exist: {database}')
    with duckdb.connect(str(database)) as con:
        con.execute('BEGIN')
        for table in ('SHELL_INPUTS', 'PROCESS_LAUNCHES'):
            con.execute(f'''UPDATE {table} SET label = COALESCE(
                override_label, NULLIF(ai_label, 'unknown'),
                NULLIF(dataset_label::VARCHAR, 'malicious-group'), 'unknown')''')
        # Closing the connection rolls back if either update fails.
        con.execute('COMMIT')


def main():
    """Parse the database path and report failures without a traceback."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--db', type=Path, default=ROOT / 'cmds.duckdb',
                        help='database path (default: cmds.duckdb in the repository root)')
    options = parser.parse_args()
    try:
        compute_final_labels(options.db)
    except (OSError, duckdb.Error) as error:
        parser.exit(1, f'{parser.prog}: {error}\n')


if __name__ == '__main__':
    main()
